# ----------------------------------------
# CareerPilot AI — Environment Configuration
# ----------------------------------------

# Application
PROJECT_NAME="CareerPilot AI"
SECRET_KEY="super-secret-careerpilot-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite default (zero external requirements):
DATABASE_URL="sqlite:///./careerpilot.db"
# Or PostgreSQL in Docker / Production:
# DATABASE_URL="postgresql+psycopg2://careerpilot:careerpilot_secure_password@localhost:5432/careerpilot"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Provider Configuration
# Options: "ollama", "openai", "fallback"
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3"

# Optional Cloud LLM Adapter (OpenAI Compatible)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Storage
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_MB=15

